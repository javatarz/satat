# Secrets for the secret store. Keep values empty here.
# To load from a file: fill a copy (secrets.* is gitignored), then run
#   just secrets < secrets.env

# GitHub fine-grained token: Contents read, Issues read.
github-read-token=

# GitHub fine-grained token: Contents and Pull requests read/write.
github-push-token=

# Claude subscription token, from `claude setup-token`.
claude-oauth-token=

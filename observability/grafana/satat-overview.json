{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    { "title": "Canvas", "url": "https://satat.karun.me/canvas/", "type": "link", "icon": "external link", "targetBlank": true },
    { "title": "ntfy", "url": "https://notify.satat.karun.me/", "type": "link", "icon": "external link", "targetBlank": true }
  ],
  "panels": [
    { "type": "row", "title": "At a glance", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false, "panels": [] },
    {
      "type": "stat",
      "title": "Spend (range)",
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "auto" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }, "expr": "sum(increase(litellm_spend_metric[$__range]))", "legendFormat": "spend" }]
    },
    {
      "type": "stat",
      "title": "Requests (range)",
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "auto" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }, "expr": "sum(increase(litellm_proxy_total_requests_metric[$__range]))", "legendFormat": "requests" }]
    },
    {
      "type": "stat",
      "title": "Tokens (range)",
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "auto" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }, "expr": "sum(increase(litellm_total_tokens_metric[$__range]))", "legendFormat": "tokens" }]
    },
    {
      "type": "stat",
      "title": "Error rate (5m)",
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 25 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "textMode": "auto" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }, "expr": "100 * sum(rate(litellm_proxy_failed_requests_metric[5m])) / clamp_min(sum(rate(litellm_proxy_total_requests_metric[5m])), 0.000001)", "legendFormat": "errors" }]
    },
    {
      "type": "stat",
      "title": "VM CPU",
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 90 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "textMode": "auto" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }, "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))", "legendFormat": "cpu" }]
    },
    {
      "type": "stat",
      "title": "VM Memory",
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 80 }, { "color": "red", "value": 92 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "textMode": "auto" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }, "expr": "100 * (1 - sum(node_memory_MemAvailable_bytes) / sum(node_memory_MemTotal_bytes))", "legendFormat": "mem" }]
    },

    { "type": "row", "title": "Spend", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "collapsed": false, "panels": [] },
    {
      "type": "timeseries",
      "title": "Spend rate by model ($/hour)",
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "custom": { "fillOpacity": 15, "lineWidth": 2, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }, "expr": "sum by (model) (rate(litellm_spend_metric{model=~\"$model\"}[$__rate_interval])) * 3600", "legendFormat": "{{model}}" }]
    },
    {
      "type": "table",
      "title": "Top models by spend (range)",
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } }, "overrides": [ { "matcher": { "id": "byName", "options": "Spend" }, "properties": [ { "id": "unit", "value": "currencyUSD" }, { "id": "decimals", "value": 3 } ] } ] },
      "options": { "showHeader": true, "cellHeight": "sm" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }, "expr": "topk(10, sum by (model) (increase(litellm_spend_metric{model=~\"$model\"}[$__range])))", "instant": true, "format": "table", "legendFormat": "Spend" } ]
    },

    { "type": "row", "title": "Models & activity", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }, "collapsed": false, "panels": [] },
    {
      "type": "timeseries",
      "title": "Requests by model",
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }, "expr": "sum by (requested_model) (rate(litellm_proxy_total_requests_metric[$__rate_interval]))", "legendFormat": "{{requested_model}}" }]
    },
    {
      "type": "timeseries",
      "title": "p95 latency by model group",
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 0, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }, "expr": "histogram_quantile(0.95, sum by (le, model_group) (rate(litellm_request_total_latency_metric_bucket[$__rate_interval])))", "legendFormat": "{{model_group}}" }]
    },
    {
      "type": "timeseries",
      "title": "Tokens by model",
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "lineWidth": 1, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }, "expr": "sum by (model) (rate(litellm_total_tokens_metric{model=~\"$model\"}[$__rate_interval]))", "legendFormat": "{{model}}" }]
    },
    {
      "type": "timeseries",
      "title": "Failures by model",
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }, "expr": "sum by (requested_model) (rate(litellm_proxy_failed_requests_metric[$__rate_interval]))", "legendFormat": "{{requested_model}}" }]
    },

    { "type": "row", "title": "Host (VM)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 }, "collapsed": false, "panels": [] },
    {
      "type": "timeseries",
      "title": "CPU %",
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }, "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])))", "legendFormat": "cpu" }]
    },
    {
      "type": "timeseries",
      "title": "Memory %",
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }, "expr": "100 * (1 - sum(node_memory_MemAvailable_bytes) / sum(node_memory_MemTotal_bytes))", "legendFormat": "mem" }]
    },
    {
      "type": "timeseries",
      "title": "Disk used %",
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }, "expr": "100 * (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs\"})", "legendFormat": "{{mountpoint}}" }]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["satat"],
  "templating": {
    "list": [
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
        "definition": "label_values(litellm_spend_metric, model)",
        "query": { "query": "label_values(litellm_spend_metric, model)", "refId": "StandardVariableQuery" },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Satat Overview",
  "uid": "satat-overview",
  "version": 1,
  "weekStart": ""
}

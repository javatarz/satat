POSTGRES_PASSWORD=change-me
# Docker socket path as seen by the Docker engine (inside the VM on colima/Docker Desktop).
# The default works there; set it only for a rootless engine.
#DOCKER_SOCKET=/run/user/1000/docker.sock
# HATCHET_CLIENT_TOKEN is created by scripts/hatchet-token.sh and written here. The Claude, read and
# write tokens are not stored in .env: scripts/compose-up.sh takes them from 1Password.

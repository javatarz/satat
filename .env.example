# Satat environment variables
# Copy to .env and fill in values. .env is gitignored.

# Contabo API credentials
CONTABO_CLIENT_ID=
CONTABO_CLIENT_SECRET=
CONTABO_API_USER=
CONTABO_API_PASSWORD=

# LLM Gateway — DevPass subscription
# API key from https://llmgateway.io/dashboard (format: llmgtwy_XXXX)
LLMGATEWAY_API_KEY=
# Exact model IDs for the three tiers (from GET /v1/models)
SATAT_MODEL_CHEAP=
SATAT_MODEL_STANDARD=
SATAT_MODEL_EXPENSIVE=

# GitHub App — Satat
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# Domain + Let's Encrypt
SATAT_DOMAIN=
SATAT_EMAIL=

# ntfy iOS push mode: "relay" (use ntfy.sh upstream) or "apns" (self-hosted APNs)
NTFY_PUSH_MODE=relay

# Firewall — your public IP/CIDR for SSH allow-list
# Leave empty to use Tailscale instead
SSH_ALLOW_CIDR=

# OpenHands Canvas API key (generate a strong random value)
CANVAS_API_KEY=

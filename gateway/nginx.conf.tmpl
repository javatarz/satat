# Satat nginx reverse proxy configuration
# T3: nginx reverse proxy + Let's Encrypt
# T6: oauth2-proxy + Headscale WireGuard

# HTTP server - redirect to HTTPS
server {
    listen 80;
    server_name ${SATAT_DOMAIN};
    
    # Let's Encrypt challenge location
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    
    # Redirect all other requests to HTTPS
    location / {
        return 301 https://$server_name$request_uri;
    }
}

# HTTPS server
server {
    listen 443 ssl;
    server_name ${SATAT_DOMAIN};
    
    # SSL configuration will be managed by certbot
    # These paths will be updated by certbot
    ssl_certificate /etc/letsencrypt/live/${SATAT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SATAT_DOMAIN}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    
    # Default location - return 200 OK
    location / {
        return 200 'Satat is running';
        add_header Content-Type text/plain;
    }
    
    # OAuth2 proxy for Canvas and ntfy
    location / {
        proxy_pass http://127.0.0.1:4180;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Uri $request_uri;
    }
    
    # LiteLLM reverse proxy (no OAuth protection)
    location /litellm/ {
        proxy_pass http://localhost:4000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    
    # Headscale reverse proxy
    location /headscale/ {
        proxy_pass http://localhost:8080/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
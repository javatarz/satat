{
	email ${SATAT_EMAIL}
}

(oauth2) {
	forward_auth oauth2-proxy:4180 {
		uri /oauth2/auth
		copy_headers X-Auth-Request-User X-Auth-Request-Email
		@unauthorized status 401
		handle_response @unauthorized {
			redir * /oauth2/sign_in?rd={scheme}://{host}{uri}
		}
	}
}

${SATAT_DOMAIN} {
	encode gzip

	handle /oauth2/* {
		reverse_proxy oauth2-proxy:4180
	}

	handle /v1/* {
		reverse_proxy litellm:4000
	}

	redir /canvas /canvas/ 308

	handle /canvas/* {
		import oauth2
		reverse_proxy canvas:8000
	}

	@agent_server path /server_info /alive /health /ready /docs /docs/* /redoc /openapi.json
	handle @agent_server {
		reverse_proxy canvas:8000
	}

	# WORKAROUND (temporary): the Agent Canvas client does not send its
	# X-Session-API-Key on Automation Server calls, so /api/automation/* 401s.
	# Gate it behind oauth2-proxy and inject the local key upstream. This must be
	# revisited before any event-driven automation: the GitHub webhook receiver
	# lives at /api/automation/v1/events/{source} and GitHub cannot OAuth, so it
	# will need its own ungated route. See ADR 0020.
	handle /api/automation/* {
		import oauth2
		reverse_proxy canvas:8000 {
			header_up -Authorization
			header_up X-Session-API-Key {env.AUTOMATION_LOCAL_API_KEY}
		}
	}

	handle /api/* {
		reverse_proxy canvas:8000
	}

	handle /sockets/* {
		reverse_proxy canvas:8000
	}

	handle {
		respond "Satat" 200
	}
}

# ntfy cannot be served under a subpath, so it gets its own hostname at /.
# Auth is ntfy's own (topic-as-password); the iOS app cannot do a browser OAuth dance.
notify.${SATAT_DOMAIN} {
	encode gzip
	reverse_proxy ntfy:8080
}

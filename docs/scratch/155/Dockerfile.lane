# PROTOTYPE for #155: a stand-in for the Claude lane image (same Node base, CLI version and managed settings).
FROM node:22.23.3-bookworm-slim@sha256:3ed98443660ff48413b5af19ecefce3b9d50845a901a43420d47cc63a9fddbe9
RUN npm install -g --omit=dev @anthropic-ai/claude-code@2.1.301 && npm cache clean --force \
  && apt-get update && apt-get install -y --no-install-recommends curl procps && rm -rf /var/lib/apt/lists/*
COPY managed-settings.json /etc/claude-code/managed-settings.json
ENV DISABLE_AUTOUPDATER=1
USER node
WORKDIR /home/node

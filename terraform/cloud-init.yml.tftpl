#cloud-config
# Satat cloud-init bootstrap
# T2: VM + firewall + DNS + cloud-init bootstrap
# T3: nginx reverse proxy + Let's Encrypt
# T6: oauth2-proxy + Headscale WireGuard

# Create satat user
users:
  - name: satat
    groups: docker
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys: []

# Install packages
packages:
  - docker.io
  - docker-compose
  - wireguard
  - curl
  - git
  - nginx
  - certbot
  - python3-certbot-nginx

# Run commands on first boot
runcmd:
  # Start and enable Docker
  - systemctl start docker
  - systemctl enable docker
  
  # Create base directories
  - mkdir -p /opt/satat/{gateway,ntfy,automations}
  - chown -R satat:satat /opt/satat
  
  # Set up WireGuard (configuration will be added later)
  - mkdir -p /etc/wireguard
  - chmod 700 /etc/wireguard
  
  # Install oauth2-proxy
  - wget https://github.com/oauth2-proxy/oauth2-proxy/releases/download/v7.6.0/oauth2-proxy-7.6.0.linux-amd64.tar.gz
  - tar -xzf oauth2-proxy-7.6.0.linux-amd64.tar.gz
  - mv oauth2-proxy-7.6.0.linux-amd64/oauth2-proxy /usr/local/bin/
  - rm -rf oauth2-proxy-7.6.0.linux-amd64*
  
  # Install Headscale
  - curl -fsSL https://raw.githubusercontent.com/juanfont/headscale/main/scripts/install.sh | bash
  
  # Set up nginx configuration
  - mkdir -p /var/www/certbot
  - echo "Satat is running" > /var/www/html/index.html
  
  # Set up certbot auto-renewal cron job
  - echo "0 12 * * * /usr/bin/certbot renew --quiet" | crontab -
  
  # Print completion message
  - echo "Satat cloud-init bootstrap completed"

# Final message
final_message: "Satat VM bootstrap complete. Access at https://${domain}"
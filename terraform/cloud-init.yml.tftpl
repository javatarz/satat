#cloud-config
# Satat cloud-init bootstrap
# T2: VM + firewall + DNS + cloud-init bootstrap
# T4: LiteLLM proxy on VM

# Create satat user
users:
  - name: satat
    groups: docker
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys: []

# Install packages
packages:
  - docker.io
  - docker-compose
  - wireguard
  - curl
  - git
  - python3-pip

# Run commands on first boot
runcmd:
  # Start and enable Docker
  - systemctl start docker
  - systemctl enable docker
  
  # Create base directories
  - mkdir -p /opt/satat/{gateway,ntfy,automations}
  - chown -R satat:satat /opt/satat
  
  # Set up WireGuard (configuration will be added later)
  - mkdir -p /etc/wireguard
  - chmod 700 /etc/wireguard
  
  # Install LiteLLM
  - pip3 install litellm
  
  # Print completion message
  - echo "Satat cloud-init bootstrap completed"

# Final message
final_message: "Satat VM bootstrap complete. Access at https://${domain}"